# VT-AIAgent — secrets. Copy to .env and fill in. NEVER commit .env
# Both cloud and local are supported; pick the active one in config/settings.toml

# --- Cloud providers (optional unless active) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local LLM endpoint (llama.cpp server / Ollama). No key needed. ---
# Nested env overrides use the VT_ prefix + "__" delimiter.
VT_LOCAL__BASE_URL=http://localhost:11434/v1
VT_LOCAL__MODEL=qwen2.5-coder:7b

# --- Active provider: anthropic | openai | local ---
VT_ACTIVE_PROVIDER=local
