#!/usr/bin/env bash
set -uo pipefail
VAD=0
SECONDS_TO_RECORD=5
while [ $# -gt 0 ]; do
  case "$1" in
    --vad) VAD=1; shift ;;
    --seconds) SECONDS_TO_RECORD="${2:-5}"; shift 2 ;;
    *) [[ "$1" =~ ^[0-9]+$ ]] && SECONDS_TO_RECORD="$1"; shift ;;
  esac
done
if ! [[ "$SECONDS_TO_RECORD" =~ ^[0-9]+$ ]] || [ "$SECONDS_TO_RECORD" -lt 1 ] || [ "$SECONDS_TO_RECORD" -gt 600 ]; then
  echo "agent-listen: --seconds must be an integer between 1 and 600 (got '${SECONDS_TO_RECORD}')" >&2; exit 2
fi
# A real interpreter is required for the level meter and the response
# parser. On Windows `python3` can be a Microsoft Store stub that exits
# without reading stdin (breaking the tee meter pipeline), so sanity-check
# each candidate and fall back: python3 -> python -> py.
MED_PY=""
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1 \
     && "$cand" -c "import sys,struct" >/dev/null 2>&1; then
    MED_PY="$cand"; break
  fi
done
if [ -z "$MED_PY" ]; then
  echo "agent-listen: need a working python on PATH (python3, python, or py)" >&2
  exit 1
fi
BASE="${LEMONADE_BASE_URL:-http://localhost:13305}"
STT_MODEL="${LEMONADE_STT_MODEL:-}"
if [ -z "$STT_MODEL" ]; then
  # Windows: the whisper.cpp recipe misbehaves on some AMD GPUs (all-zero
  # encoder output -> hallucinated fillers), while the Moonshine recipes
  # transcribe correctly; default to Moonshine there, Whisper elsewhere.
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) STT_MODEL="Moonshine-Tiny-Streaming" ;;
    *) STT_MODEL="Whisper-Tiny" ;;
  esac
fi
WAV="$(mktemp "${TMPDIR:-/tmp}/agent-listen.XXXXXX.wav")"
trap 'rm -f "$WAV"' EXIT
METER='import sys,time,struct,math
buf=sys.stdin.buffer
end=time.time()+float(sys.argv[1])
while time.time()<end:
    chunk=buf.read(3200)
    if not chunk: break
    n=len(chunk)//2
    if n==0: continue
    vals=struct.unpack(f"<{n}h",chunk[:n*2])
    rms=math.sqrt(sum(v*v for v in vals)/n)
    level=min(rms/6000.0,1.0)
    bar="█"*int(level*20)
    sys.stdout.write("\r● Listening  ["+bar.ljust(20)+"] "+f"{level:.0%}"+"   ")
    sys.stdout.flush()
sys.stdout.write("\n")'
record_ok=0
if [ "$VAD" = 1 ] && command -v arecord >/dev/null 2>&1; then
  "$MED_PY" - "$SECONDS_TO_RECORD" > "$WAV" <<'VADPY'
import math, struct, subprocess, sys, time
maxlen = float(sys.argv[1]) * 16000 * 2
proc = subprocess.Popen(
    ["arecord", "-q", "-r", "16000", "-c", "1", "-f", "S16_LE", "-t", "raw"],
    stdout=subprocess.PIPE)
t0 = time.time()
buf = b""
started = False
silence = 0.0
chunk = 1600  # 50ms @16kHz S16LE
try:
    while time.time() - t0 < maxlen / (16000 * 2):
        data = proc.stdout.read(chunk)
        if not data:
            break
        n = len(data) // 2
        if n == 0:
            continue
        vals = struct.unpack(f"<{n}h", data[: n * 2])
        rms = math.sqrt(sum(v * v for v in vals) / n)
        speech = rms > 6000
        if speech:
            started = True
            silence = 0.0
        elif started:
            silence += 0.05
            if silence > 1.5:
                break
        buf += data
        level = min(rms / 6000.0, 1.0)
        sys.stderr.write("\r● Listening  [" + "█" * int(level * 20) + "] " + f"{level:.0%}" + "   ")
        sys.stderr.flush()
finally:
    proc.kill()
sys.stderr.write("\n")
header = b"RIFF" + struct.pack("<I", 36 + len(buf)) + b"WAVEfmt " + struct.pack("<IHHIIHH", 16, 1, 1, 16000, 32000, 2, 16) + b"data" + struct.pack("<I", len(buf))
sys.stdout.buffer.write(header + buf)
VADPY
  record_ok=1
elif command -v arecord >/dev/null 2>&1; then
  arecord -q -d "$SECONDS_TO_RECORD" -r 16000 -c 1 -f S16_LE -t wav | tee "$WAV" | "$MED_PY" -u -c "$METER" "$SECONDS_TO_RECORD" >&2 && record_ok=1 || true
elif command -v ffmpeg >/dev/null 2>&1; then
  # AGENT_LISTEN_FF_INPUT overrides the capture input (device indexes vary
  # per machine; list them with `ffmpeg -f avfoundation -list_devices true -i ""`).
  # Audio-only on macOS (":0" = first audio device, no video). An array holds
  # the input spec so no quote juggling is needed on expansion.
  case "$(uname -s)" in
    Darwin) FF_IN=(-f avfoundation -i ":0") ;;
    MINGW*|MSYS*|CYGWIN*)
      FF_MODE=file
      if [ -n "${AGENT_LISTEN_FF_INPUT:-}" ]; then
        FF_IN=(-f dshow -i "$AGENT_LISTEN_FF_INPUT")
      elif command -v ffmpeg >/dev/null 2>&1; then
        # Windows dshow needs the exact device name (partial names are not
        # matched), and names contain spaces — so auto-pick the first audio
        # capture device and keep `-i audio=<name>` as ONE arg.
        d="$(ffmpeg -hide_banner -f dshow -list_devices true -i dummy 2>&1 \
              | grep -m1 '(audio)' | sed 's/^\[[^]]*\] "\([^"]*\)".*/\1/')"
        FF_IN=(-f dshow -i "audio=$d")
      else
        FF_IN=(-f dshow -i "audio=Microphone")
      fi
      ;;
    *) FF_IN=(-f pulse -i default) ;;
  esac
  if [ -n "${AGENT_LISTEN_FF_INPUT:-}" ] \
     && [[ "${FF_IN[0]}" == "-f" ]] && [[ "${FF_IN[1]}" != dshow ]]; then
    # Non-dshow overrides keep the original word-split flag-string semantics.
    FF_IN=($AGENT_LISTEN_FF_INPUT)
  fi
  # The level meter exits after N seconds, closing the pipe while ffmpeg is
  # still writing: under `set -o pipefail` that reads as failure, so success
  # is judged by the captured file, not the pipeline status.
  if [ "${FF_MODE:-}" = file ]; then
    # Windows dshow: capture directly to a real file. Pipe-written WAVs
    # carry placeholder RIFF sizes (ffmpeg cannot seek back), which
    # whisper.cpp tolerates but file-shaped parsers reject; and mktemp's
    # pre-created empty file requires -y to overwrite.
    ffmpeg -y -hide_banner -nostdin -loglevel error "${FF_IN[@]}" \
      -t "$SECONDS_TO_RECORD" -ar 16000 -ac 1 -f wav "$WAV" 2>/dev/null \
      && record_ok=1
  else
    ffmpeg -hide_banner -nostdin -loglevel error "${FF_IN[@]}" -t "$SECONDS_TO_RECORD" -ar 16000 -ac 1 -f wav pipe:1 2>/dev/null \
      | tee "$WAV" | "$MED_PY" -u -c "$METER" "$SECONDS_TO_RECORD" >&2 || true
    # ffmpeg cannot seek back in a pipe, so the captured WAV carries
    # placeholder RIFF sizes; file parsers other than whisper.cpp (e.g.
    # Lemonade's own) reject it. Remux through a real file output to
    # rebuild the header in place.
    ffmpeg -y -hide_banner -loglevel error -i "$WAV" -c copy "$WAV.fix" \
      </dev/null >/dev/null 2>&1 && mv -f "$WAV.fix" "$WAV"
    [ -s "$WAV" ] && record_ok=1
  fi
else
  echo "agent-listen: need arecord or ffmpeg" >&2; exit 1
fi
if [ "$record_ok" != 1 ] || [ ! -s "$WAV" ]; then
  echo "agent-listen: recording failed (mic not capturing)" >&2; exit 3
fi
for attempt in 1 2 3; do
  # Native curl builds on Windows cannot open MSYS /tmp paths inside -F
  # (path-conversion heuristics skip mixed-content arguments), so hand curl
  # the Windows form of the path. POSIX stays as-is.
  if [[ "$(uname -s)" =~ ^MINGW|^MSYS|^CYGWIN ]]; then
    WAV_CURL="$(cygpath -w "$WAV")"
  else
    WAV_CURL="$WAV"
  fi
  resp="$(curl -sf --max-time 60 -X POST "$BASE/v1/audio/transcriptions" \
    -F "file=@$WAV_CURL" -F "model=$STT_MODEL")" && break
  echo "agent-listen: STT request failed (attempt $attempt/3)" >&2
  sleep 1
done
if [ -z "${resp:-}" ]; then
  echo "agent-listen: STT server unreachable at $BASE" >&2; exit 4
fi
"$MED_PY" - "$resp" <<'PY'
import json, sys
try:
    data = json.loads(sys.argv[1])
except json.JSONDecodeError:
    sys.stderr.write("agent-listen: STT returned invalid JSON: %r\n" % sys.argv[1][:200])
    raise SystemExit(5)
text = (data.get("text") or "").strip()
if not text or text in {"[BLANK_AUDIO]", "<|audio|>", "(silence)"}:
    sys.stderr.write("agent-listen: no speech detected — check mic input\n")
    raise SystemExit(6)
if len(text) > 2000:
    sys.stderr.write("agent-listen: transcript suspiciously long (%d chars) — possible garbage\n" % len(text))
print(text)
PY
